#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "cc" ]]; then
  exit 2
fi
shift

: "${OLLVM_DIR:?}"
clang="$OLLVM_DIR/bin/clang"
if [[ ! -x "$clang" ]]; then
  exit 2
fi

level="${OBFUSCATION:-max}"
flags=()
if [[ "$level" != "off" ]]; then
  flags_file="$OLLVM_DIR/flags-$level.txt"
  if [[ -s "$flags_file" ]]; then
    mapfile -t flags < "$flags_file"
  fi
fi

exec "$clang" \
  -fuse-ld=lld \
  -B "$OLLVM_DIR/bin" \
  -Wno-unused-command-line-argument \
  "${flags[@]+"${flags[@]}"}" \
  "$@"
