#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "cc" ]]; then
  exit 2
fi
shift

: "${OLLVM_DIR:?}"
clang="$(find "$OLLVM_DIR/bin" -maxdepth 1 \( -name clang -o -name 'clang-[0-9]*' \) | head -1)"
plugin="$OLLVM_DIR/omvll_linux.so"
if [[ ! -x "$clang" || ! -f "$plugin" ]]; then
  exit 2
fi

root="${GITHUB_WORKSPACE:-$(cd "$(dirname "$0")/../.." && pwd)}"
shim="$root/scripts/shim.h"

args=()
if [[ "${OBFUSCATION:-on}" != "off" ]]; then
  export OMVLL_CONFIG="$OLLVM_DIR/policy.py"
  export OMVLL_PYTHONPATH="$OLLVM_DIR/pythonlib"
  args+=("-fpass-plugin=$plugin")
fi

exec "$clang" ${args[@]+"${args[@]}"} -include "$shim" -fuse-ld=lld -B "$OLLVM_DIR/bin" \
  -Wno-unused-command-line-argument "$@"
